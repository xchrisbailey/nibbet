#!/usr/bin/env bash
# Launch sett against a throwaway copy of fixture data, screenshot its window, quit.
#
#   scripts/screenshot [--root DIR] [--target DIR] [--space personal|work] [--editor block|raw]
#                      [--screen journal|notes|templates] [--open SLUG] [--insert-menu]
#                      [--appearance light|dark] [--data DIR] [--delay SECS] OUT.png
#
# --root builds and runs the checkout at DIR (another worktree) instead of this
# one. --target is the Cargo target dir to build into (default: $CARGO_TARGET_DIR,
# else DIR/target); pass the worktree's own, e.g. ../sett-wt/.target-<name>.
# Relative paths are taken from the directory you run the script in.
#
# --data defaults to scripts/fixtures/sett. The copy lives in a temp HOME, so the
# real ~/sett and settings are never touched. The app opens on the Space's Inbox
# Board, or with --open on the Item a Link to SLUG leads to, in the editor.
# --screen opens Journal, Notes or Templates instead; with --screen templates,
# --open SLUG opens that Template. --insert-menu opens the Insert Menu on the
# opened body's last paragraph when it starts with `/`; the text after the `/`
# is the query. The fixtures' `insert-menu` Note ends in a bare `/`.
# For other content, edit a copy of the fixtures.
# --appearance forces Light or Dark for this launch (default: the system's),
# leaving the system setting alone.
# --delay (seconds, default 1) waits for the first frames to render.
# A tiling window manager can shrink the window well below the 1024x720 pt sett
# asks for; the script then warns, and Columns past the first may be cut off.
# Needs Screen Recording permission for the app that runs the shell (System
# Settings → Privacy & Security → Screen Recording); the script checks first.
# Claude Code: run it as its own Bash call starting with `scripts/screenshot`,
# with options rather than `X=...` before it. The sandbox exception in
# .claude/settings.json only matches that form. Subagents can't capture at all;
# see docs/agents/worktrees.md.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
space=personal
editor=block
data="$root/scripts/fixtures/sett"
out=""
target="${CARGO_TARGET_DIR:-}"
delay=1
open=()
extra=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --space) space="$2"; shift 2 ;;
        --editor) editor="$2"; shift 2 ;;
        --data) data="$2"; shift 2 ;;
        --target) target="$2"; shift 2 ;;
        --open) open=(--open "$2"); shift 2 ;;
        --screen) extra+=(--screen "$2"); shift 2 ;;
        --insert-menu) extra+=(--insert-menu); shift ;;
        --appearance) extra+=(--appearance "$2"); shift 2 ;;
        --delay) delay="$2"; shift 2 ;;
        --root) root="$(cd "$2" && pwd)"; data="$root/scripts/fixtures/sett"; shift 2 ;;
        -h|--help) sed -n '2,31p' "$0"; exit 0 ;;
        *) out="$1"; shift ;;
    esac
done
[[ -n "$out" ]] || { echo "usage: scripts/screenshot [--root DIR] [--target DIR] [--space S] [--editor E] [--screen S] [--open SLUG] [--insert-menu] [--appearance A] [--data DIR] [--delay SECS] OUT.png" >&2; exit 2; }

no_permission() {
    echo "screenshot: no Screen Recording permission. Allow the app running this shell (Terminal, your editor or agent host) in System Settings → Privacy & Security → Screen Recording, then restart that app." >&2
    exit 1
}
# Checked before the build so a missing permission costs seconds, not a compile.
swift "$here/can-capture.swift" || { [[ $? -eq 3 ]] && no_permission; echo "screenshot: couldn't run can-capture.swift" >&2; exit 1; }

# The build runs inside $root, so a relative target dir must be pinned to the
# caller's directory first or the build and the binary we launch disagree.
target="${target:-$root/target}"
[[ "$target" = /* ]] || target="$PWD/$target"
(cd "$root" && CARGO_TARGET_DIR="$target" cargo build -q -p sett)

home="$(mktemp -d)"
trap 'kill "$pid" 2>/dev/null || true; rm -rf "$home"' EXIT
cp -R "$data" "$home/sett"
mkdir -p "$home/Library/Application Support/sett"
cat > "$home/Library/Application Support/sett/settings.toml" <<EOF
data_root = "$home/sett"
editor_mode = "$editor"
last_space = "$space"
EOF

HOME="$home" "$target/debug/sett" ${open[@]+"${open[@]}"} ${extra[@]+"${extra[@]}"} >"$home/sett.log" 2>&1 &
pid=$!

id=""
for _ in $(seq 1 60); do
    kill -0 "$pid" 2>/dev/null || { echo "sett exited early:" >&2; cat "$home/sett.log" >&2; exit 1; }
    found="$(swift "$here/window-id.swift" "$pid" 2>/dev/null || true)"
    read -r id width height <<<"$found" || true
    [[ -n "${id:-}" ]] && break
    sleep 0.5
done
[[ -n "${id:-}" ]] || { echo "no sett window appeared within 30s" >&2; exit 1; }
if (( width < 960 || height < 640 )); then
    echo "screenshot: the window is ${width}x${height} pt, not 1024x720 (a tiling window manager?); Columns past the first may be cut off" >&2
fi

sleep "$delay" # let the first frames render
if ! screencapture -x -o -l "$id" "$out"; then
    echo "screenshot: capture failed although Screen Recording is allowed. In Claude Code this means the sandbox: run scripts/screenshot as its own Bash call, from the main session (subagents can't capture)." >&2
    exit 1
fi
echo "$out"
